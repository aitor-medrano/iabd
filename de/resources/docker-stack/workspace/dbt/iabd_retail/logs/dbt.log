    create  table
      "retail_el"."main"."dim_cliente__dbt_tmp"
  
    
    as (
      with clientes as (
    select * from "retail_el"."main"."stg_customers"
),
base as (
    select
        row_number() over (order by cliente_id)   as cliente_sk,
        cliente_id,
        nombre || ' ' || apellido                 as nombre,
        ciudad,
        provincia
    from clientes
)

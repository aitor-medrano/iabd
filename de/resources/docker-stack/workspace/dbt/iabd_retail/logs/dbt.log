[0m16:35:50.681183 [debug] [Thread-1 (]: On model.iabd_retail.tasa_devolucion_departamento: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "iabd_retail", "target_name": "dev", "node_id": "model.iabd_retail.tasa_devolucion_departamento"} */

    

    create  table
      "retail_el"."main"."tasa_devolucion_departamento__dbt_tmp"
  
    
    as (
      with v as (
    select dp.departamento,
           sum(fv.cantidad)           as unidades_vendidas,
           round(sum(fv.importe), 2)  as ingresos
    from "retail_el"."main"."fact_ventas" fv
    join "retail_el"."main"."dim_producto" dp on dp.producto_sk = fv.producto_sk
    where fv.estado in ('COMPLETE', 'CLOSED')
    group by dp.departamento
),
d as (
    select dp.departamento,
           sum(fd.unidades)            as unidades_devueltas,
           round(sum(fd.importe), 2)   as importe_devuelto
    from "retail_el"."main"."fact_devoluciones" fd
    join "retail_el"."main"."dim_producto" dp on dp.producto_sk = fd.producto_sk
    group by dp.departamento
)
select
    v.departamento,
    v.unidades_vendidas,
    coalesce(d.unidades_devueltas, 0)   as unidades_devueltas,
    v.ingresos,
    coalesce(d.importe_devuelto, 0)     as importe_devuelto,
    round(100.0 * coalesce(d.unidades_devueltas, 0) / v.unidades_vendidas, 1) as tasa_devolucion_pct
from v
left join d on d.departamento = v.departamento
order by tasa_devolucion_pct desc
    );
    
  

{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.3", "generated_at": "2026-11-04T16:56:19.344398Z", "invocation_id": "547e6c56-a133-42ad-9c9a-a0d5986f2cc3", "invocation_started_at": "2026-11-04T16:56:17.257542Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-04T16:56:19.058699Z", "completed_at": "2026-11-04T16:56:19.074001Z"}, {"name": "execute", "started_at": "2026-11-04T16:56:19.074880Z", "completed_at": "2026-11-04T16:56:19.143733Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.08810186386108398, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.iabd_retail.int_ventas_enriquecidas", "compiled": true, "compiled_code": "-- Grano: una l\u00ednea de pedido entregada.\n-- Resuelve una sola vez el join con dim_producto y la regla de negocio\n-- \"s\u00f3lo pedidos entregados\", que necesitan los dos marts de departamento.\nwith ventas as (\n    select * from \"retail_el\".\"main\".\"fact_ventas\"\n),\nproducto as (\n    select * from \"retail_el\".\"main\".\"dim_producto\"\n)\nselect\n    v.linea_id,\n    v.pedido_id,\n    v.producto_sk,\n    dp.departamento,\n    dp.categoria,\n    v.fecha_id,\n    v.cantidad,\n    v.importe\nfrom ventas v\njoin producto dp on dp.producto_sk = v.producto_sk\nwhere v.estado in ('COMPLETE', 'CLOSED')", "relation_name": "\"retail_el\".\"main\".\"int_ventas_enriquecidas\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-04T16:56:19.160989Z", "completed_at": "2026-11-04T16:56:19.175738Z"}, {"name": "execute", "started_at": "2026-11-04T16:56:19.181908Z", "completed_at": "2026-11-04T16:56:19.314118Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.16074919700622559, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.iabd_retail.tasa_devolucion_departamento", "compiled": true, "compiled_code": "with v as (\n    select departamento,\n           sum(cantidad)            as unidades_vendidas,\n           round(sum(importe), 2)   as ingresos\n    from \"retail_el\".\"main\".\"int_ventas_enriquecidas\"\n    group by departamento\n),\nd as (\n    select dp.departamento,\n           sum(fd.unidades)            as unidades_devueltas,\n           round(sum(fd.importe), 2)   as importe_devuelto\n    from \"retail_el\".\"main\".\"fact_devoluciones\" fd\n    join \"retail_el\".\"main\".\"dim_producto\" dp on dp.producto_sk = fd.producto_sk\n    group by dp.departamento\n)\nselect\n    v.departamento,\n    v.unidades_vendidas,\n    coalesce(d.unidades_devueltas, 0)   as unidades_devueltas,\n    v.ingresos,\n    coalesce(d.importe_devuelto, 0)     as importe_devuelto,\n    round(100.0 * coalesce(d.unidades_devueltas, 0) / v.unidades_vendidas, 1) as tasa_devolucion_pct\nfrom v\nleft join d on d.departamento = v.departamento\norder by tasa_devolucion_pct desc", "relation_name": "\"retail_el\".\"main\".\"tasa_devolucion_departamento\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-04T16:56:19.158455Z", "completed_at": "2026-11-04T16:56:19.169219Z"}, {"name": "execute", "started_at": "2026-11-04T16:56:19.170240Z", "completed_at": "2026-11-04T16:56:19.318445Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.16671514511108398, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.iabd_retail.ingresos_por_departamento", "compiled": true, "compiled_code": "with ventas as (\n    select * from \"retail_el\".\"main\".\"int_ventas_enriquecidas\"\n)\nselect\n    departamento,\n    count(distinct pedido_id)   as pedidos,\n    sum(cantidad)               as unidades,\n    round(sum(importe), 2)      as ingresos\nfrom ventas\ngroup by departamento\norder by ingresos desc", "relation_name": "\"retail_el\".\